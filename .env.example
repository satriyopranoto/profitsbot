# Kredensial Profits (isi sendiri — jangan commit!)
PROFITS_USERNAME=
PROFITS_PASSWORD=
PROFITS_PIN=

# ---------- Chart ----------
# TIMEFRAME sinyal dikontrol PROFITS_SCAN_INTERVAL (bawah) — BUKAN cuma nilai
# CHART_RESOLUTION. fetch_ohlc memetakan interval itu ke resolution TradingView.
# countback api_server = 2000 (hardcoded di kode).

# ---------- Parameter Indikator (Basis ADX) ----------
PROFITS_ADX_PERIOD=14                  # period ADX (Wilder)
PROFITS_ADX_THRESHOLD=20               # minimal ADX utk sinyal tren
PROFITS_DONCHIAN_PERIOD=10             # period Donchian (lookback SL = 2.8 x 10 = 28 bar)
PROFITS_DONCHIAN_MULTIPLE=2.8          # SL multiple (lookback = 2.8 x period)
# Trigger SL = level band-bawah − 1 tick IDX (tick_size), paritas protraderbot.
# SL dipasang SEGERA setelah BUY (retry), reconcile_sl = jaring pengaman.
PROFITS_SL_RETRY=3                     # percobaan pasang SL stlh BUY (posisi baru kadang belum ter-registrasi)
PROFITS_SL_RETRY_DELAY=3               # jeda antar percobaan (detik)

# ---------- Strategi sinyal ----------
PROFITS_STRATEGY=adx_rsi               # adx_rsi (default = perilaku lama) | cr (Candle Rejection)
# ⚠️ mode cr MENGABAIKAN gate uptrend (PROFITS_BUY_UPTREND_ONLY) — keputusan user 30-Sep-2026:
# CR = early entry, gate uptrend berlawanan dgn desainnya.
# knob mode cr (dipakai HANYA kalau PROFITS_STRATEGY=cr; TF ikut PROFITS_SCAN_INTERVAL):
PROFITS_CR_RSI_PERIOD=14               # RSI Wilder utk gate sinyal
PROFITS_CR_RSI_BUYIT=70                # Buyit butuh RSI > ini (parity Pine/EA in_rsi_buyit)
PROFITS_CR_RSI_SHORTIT=30              # Shortit butuh RSI < ini (= pemicu EXIT LONG/FLIP)
PROFITS_CR_SL_SWITCH_PERIOD=28          # switch-SL/lookback (bar) = 2.8 x 10, parity EA
PROFITS_CR_SCORE_ROC=60                # skor ranking -ROC(60) ("paling turun dulu")
PROFITS_CR_SCORE_ORDER=fallen          # fallen = skor terbesar dulu (default) | riser = paling naik dulu
PROFITS_CR_MIN_BARS=150                # minimal bar data utk sinyal CR (kalau kurang -> HOLD)
PROFITS_CR_DATA_RANGE=1y               # range fallback Yahoo (biar bar cukup di TF harian)
PROFITS_CR_NO_LATCH=1                  # 1 = parity runner 25-Sep (tanpa latch hbuyon/lsellon)
PROFITS_BOLLINGER_PERIOD=20            # period Bollinger Bands
PROFITS_BOLLINGER_STD=2                # jumlah standar deviasi

# ---------- Watchlist & Filter ----------
PROFITS_TOP_VALUES=15                  # top N by value (top-stocks Profits)
PROFITS_FILTER_DISCRETE=1              # skip saham "discrete" (banyak bar flat)
PROFITS_MAX_FLAT_PCT=50                # threshold flat %
# HANYA beli saham harga >= ambang (RUPIAH PENUH, mis. 100; 0 = nonaktif).
# Filter fundamental: cegah saham murah ikut terbeli. Tampil SKIP-PRICE di
# listing scan & tidak dieksekusi. Berlaku HANYA utk beli; saham yg sudah di
# holding tetap boleh dijual (SHORT/TP exit tanpa filter harga).
PROFITS_MIN_PRICE=100
# ⚠️ Floor NILAI TRANSAKSI watchlist (RUPIAH PENUH, mis. 100000000000 = 100B; 0 = nonaktif).
# Sumber top-values = akumulasi nilai HARIAN yg DI-RESET tiap 08:00 WIB → pagi hari nilainya
# masih kecil (mis. 30-Sep-2026 09:10, seluruh pasar baru 16–50B) sehingga floor 100B bisa
# menyisakan 1–2 nama sampai siang. PARITAS: samakan dgn protraderbot `MIN_TOP_VAL`.
# ⚠️ JANGAN HAPUS key ini — kalau absen, kode jatuh ke DEFAULT 15B & floor tinggimu tidak
# berlaku (kejadian 30-Sep-2026: MBSS 16,54B kebeli padahal niat floor 100B).
PROFITS_MIN_TOP_VAL=100000000000

# ---------- Mode & Eksekusi ----------
PROFITS_BOT_MODE=trade              # nontrade = scan/log; trade = order REAL
PROFITS_TRADE_LOT=0                    # lot per order (1 = uji coba; 0 = pakai sizing)
PROFITS_TEST_SYMBOL=                   # mis. BBCA = test cycle langsung di saham itu
PROFITS_TP_PCT=0.5                       # exit check: floating profit > 0.5% -> SELL TP
PROFITS_BUY_UPTREND_ONLY=1              # buy HANYA uptrend kuat (adx_sma_pct)
PROFITS_UPTREND_MIN_PCT=35               # ambang bullish pct (35 = Uptrend Kuat)
PROFITS_USE_FLIP=1                     # FLIP: sinyal SELL saat LONG = tutup posisi (jual penuh)
PROFITS_MARKET_HOURS=0                    # 0 = bot 24 jam (testing); 1 = cuma jam bursa
PROFITS_MARKET_OPEN=09:00                 # jam buka pasar WIB (kalau PROFITS_MARKET_HOURS=1)
PROFITS_MARKET_CLOSE=15:50                # jam tutup pasar WIB = IDX pre-closing 15:50 (paritas
                                          #   protraderbot MARKET_CLOSE=15:50). JANGAN 15:30 —
                                          #   bikin bot stop scan + stop cek exit/TP 20 mnt terakhir.
                                          #   ⚠️ dibaca SAAT IMPORT: ganti butuh restart bot.
PROFITS_CYCLE_MINUTES=3                # interval scan (menit)
PROFITS_SCAN_INTERVAL=30m              # ★TIMEFRAME SINYAL (30m source-of-truth) — di-map ke resolution chart via res_map di fetch_ohlc. Ganti ini utk ubah timeframe, BUKAN PROFITS_CHART_RESOLUTION (sudah dihapus)

# ---------- Sizing / Risk ----------
PROFITS_CAPITAL=100000000              # modal default 100 juta
PROFITS_RISK_PCT=1.0                   # risk exposure per posisi (%)
PROFITS_ORDER_VALUE=20000000                  # budget nilai per order (0 = sizing + sisa cash)
PROFITS_ADX_PCT_WINDOW=100
PROFITS_ADX_PCT_MIN_BARS=60
# RSI filter (paritas EA Basis_ADX_RSI): BUY long RSI>RSI_BUY_MIN(70), SHORT/FLIP RSI<RSI_SELL_MAX(30); anti-sideway
PROFITS_USE_RSI_FILTER=0
PROFITS_RSI_BUY_MIN=70
PROFITS_RSI_SELL_MAX=30
# Switch SL (paritas EA/protraderbot/usbot): sl = ac==1 ? s(low) : r(high).
#   ac = arah Donchian-breakout terakhir. Saat regime DOWN (ac=-1) sl = band ATAS =>
#   high<sl mudah -> sinyal SHORT/FLIP lebih awal. FLIP tetap HANYA kalau rumus short
#   PENUH terpenuhi (ADX>min&naik, -DI>+DI&-DI naik, RSI<sell). 1=selalu switch (default),
#   0=legacy (Donchian lower dari close). Perbaikan propagasi error yg diwarisi usbot.
PROFITS_SWITCH_SL=1
