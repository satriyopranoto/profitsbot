# test Yahoo Finance utk OHLC saham IDX (suffix .JK) — daily & 15m
import json, urllib.request, time

def get(url):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:
            return json.loads(resp.read().decode())
    except Exception as e:
        return f"ERR {e}"

print("=== 1. ANTM.JK daily 3 bulan ===")
r = get("https://query1.finance.yahoo.com/v8/finance/chart/ANTM.JK?range=3mo&interval=1d")
if isinstance(r, dict):
    res = r.get("chart", {}).get("result") or []
    if res:
        ts = res[0].get("timestamp") or []
        q = res[0].get("indicators", {}).get("quote", [{}])[0]
        print(f"  candles: {len(ts)}")
        for i in range(max(0, len(ts) - 3), len(ts)):
            import datetime
            d = datetime.datetime.utcfromtimestamp(ts[i]).strftime("%Y-%m-%d")
            print(f"    {d}: O {q['open'][i]} H {q['high'][i]} L {q['low'][i]} C {q['close'][i]} V {q['volume'][i]}")
    else:
        print("  kosong:", json.dumps(r)[:200])
else:
    print("  ", r)

print("\n=== 2. ANTM.JK 15 menit (range 5d) ===")
r = get("https://query1.finance.yahoo.com/v8/finance/chart/ANTM.JK?range=5d&interval=15m")
if isinstance(r, dict):
    res = r.get("chart", {}).get("result") or []
    if res:
        ts = res[0].get("timestamp") or []
        q = res[0].get("indicators", {}).get("quote", [{}])[0]
        print(f"  candles: {len(ts)}")
        for i in range(max(0, len(ts) - 3), len(ts)):
            import datetime
            d = datetime.datetime.utcfromtimestamp(ts[i]).strftime("%m-%d %H:%M")
            print(f"    {d}: O {q['open'][i]} H {q['high'][i]} L {q['low'][i]} C {q['close'][i]}")
    else:
        print("  kosong:", json.dumps(r)[:200])
else:
    print("  ", r)

print("\n=== 3. BBCA.JK daily 6 bulan ===")
r = get("https://query1.finance.yahoo.com/v8/finance/chart/BBCA.JK?range=6mo&interval=1d")
if isinstance(r, dict):
    res = r.get("chart", {}).get("result") or []
